# Local tooling, private settings and machine caches.
.agents/
.codex/
.env
.env.*
!.env.example
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
desktop.ini

# Expanded art deliveries are tracked; duplicate archives stay local.
*.zip
*.7z
*.rar
*.blend1
*.blend2

# Model weights belong to the local ComfyUI installation, not game source.
*.safetensors
*.ckpt
*.pth
*.pt
*.onnx

# Keep selected screenshots, reports, capture metadata/audio and encoded videos.
# Numbered recorder frames stay local; encoded video and capture data are kept.
/Docs/Production/**/*_capture/[0-9][0-9][0-9][0-9][0-9].jpg
/Docs/Production/**/*_capture/[0-9][0-9][0-9][0-9][0-9].png

# Disposable verification compiler output, not the source scripts or reports.
/Docs/Production/**/*_Verification/*.dll
/Docs/Production/**/*_Verification/*.pdb
/Docs/Production/**/*_Verification/*.rsp
